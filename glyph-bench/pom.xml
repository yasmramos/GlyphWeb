<?xml version="1.0" encoding="UTF-8"?>
<!--
  glyph-bench: JMH microbenchmark harness for the GlyphWeb hot paths.

  Purpose (M3): prove the zero-allocation claims of the event fan-out
  (SignalBus / GlyphEventPump) with -prof gc instead of relying on review
  alone, and quantify Java<->native round-trip latency for both JNI
  (JavaCPP) and Panama (java.lang.foreign) call styles.

  This module is NOT part of the library artifact set; it is executed via
  `mvn -pl glyph-bench package` which produces an executable shaded jar:
      java -jar glyph-bench/target/benchmarks.jar
  or a single quick run:
      java -jar glyph-bench/target/benchmarks.jar SignalBusBenchmark -f 1 -wi 3 -i 3
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.glyph</groupId>
    <artifactId>glyph-web</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>glyph-bench</artifactId>
  <packaging>jar</packaging>
  <name>GlyphWeb Benchmarks (JMH)</name>

  <properties>
    <!-- JMH 1.37 supports JDK 17+ including the FFM API (final in 22). -->
    <jmh.version>1.37</jmh.version>
    <!-- Benchmarks must never be treated as tests by surefire/failsafe. -->
    <maven.test.skip>true</maven.test.skip>
  </properties>

  <dependencies>
    <!-- Benchmark the real production code, not copies of it. -->
    <dependency>
      <groupId>io.glyph</groupId>
      <artifactId>glyph-web-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
      <version>${jmh.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-generator-annprocess</artifactId>
      <version>${jmh.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>benchmarks</finalName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.openjdk.jmh.Main</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
